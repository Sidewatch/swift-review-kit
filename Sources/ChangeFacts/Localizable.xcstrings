    "%@ dependency manifest — this change alters what third-party code the project pulls in." : {
      "comment" : "Tool-tip on a changed dependency file; the argument is the ecosystem's name, such as npm or Cargo",
      "localizations" : {
        "de" : {
          "stringUnit" : {
